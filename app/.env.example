# The browser running the Amazon login must be able to reach this address.
# ALEXA_PROXY_HOST=192.168.1.50
ALEXA_PROXY_PORT=8098
AMAZON_DOMAIN=amazon.com
ALEXA_DATA_DIR=./data
ALEXA_CAPTURE_FIXTURES=false
ALEXA_DEBUG=false
ALEXA_ONCE=false

# Phase 2: point these at an MQTT broker. Username/password are optional.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=amazon_air_quality
POLL_INTERVAL=60
